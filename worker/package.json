{
  "name": "scicomi-portal-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply scicomi-portal --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply scicomi-portal --remote",
    "test": "node --test --test-concurrency=1"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
